{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nonsplayer",
  "version": "0.5.9",
  "identifier": "nonsplayer",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "NonsPlayer",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Miaoyww/NonsPlayer/releases/latest/download/latest.json"
      ],
      "pubkey": "MCowBQYDK2VwAyEAgsB/tSCk356/XgLvzZ/2+LDl3Hatqlo213O+A/k3zXE="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
