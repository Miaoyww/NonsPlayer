{
  "id": "netease-download",
  "name": "网易云下载",
  "description": "下载网易云歌曲到本地，管理下载队列、音质与保存目录。",
  "repository": "https://github.com/Miaoyww/Nons",
  "version": "1.1.0",
  "frontend": "ui.mjs",
  "configuration": "configuration.json",
  "permissions": [
    "ui",
    "config",
    "storage",
    "account:credentials",
    "player:control",
    "http:request",
    "http:transfer",
    "files:selected"
  ],
  "httpHosts": ["*"],
  "engines": {
    "app": "^1.0.0",
    "pluginApi": "^2.0.0",
    "uiApi": "^2.0.0"
  },
  "contributes": {
    "contextMenus": [
      {
        "id": "download",
        "target": "song",
        "source": "netease",
        "label": "下载",
        "icon": "download",
        "export": "downloadSong"
      }
    ],
    "pages": [
      {
        "id": "downloads",
        "path": "/",
        "export": "DownloadsPage"
      }
    ],
    "navigation": [
      {
        "id": "downloads-entry",
        "label": "下载管理",
        "page": "downloads"
      }
    ]
  }
}
