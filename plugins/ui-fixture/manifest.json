{
  "id": "ui-fixture",
  "name": "SDK UI Fixture",
  "description": "Exercises the public plugin UI and authorization contracts.",
  "repository": "https://example.org/plugins/ui-fixture",
  "version": "1.0.0",
  "frontend": "ui.mjs",
  "permissions": ["ui", "player:read", "player:control", "storage"],
  "engines": { "app": "^1.0.0", "pluginApi": "^3.0.0", "uiApi": "^3.0.0" },
  "contributes": {
    "views": [
      { "id": "preview", "slot": "main.overlay", "export": "Preview" },
      {
        "id": "fullscreen-details",
        "slot": "fullscreen.player.panel",
        "label": "测试面板",
        "export": "FullscreenDetailsPanel"
      },
      {
        "id": "fullscreen-details-action",
        "slot": "fullscreen.player.actions",
        "export": "FullscreenDetailsAction"
      }
    ],
    "pages": [],
    "navigation": []
  }
}
