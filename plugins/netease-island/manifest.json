{
  "id": "netease-island",
  "name": "灵动岛",
  "description": "识别剪贴板中的网易云音乐链接，在灵动岛中查看歌曲并快速播放。",
  "repository": "https://github.com/Miaoyww/Nons",
  "version": "1.3.0",
  "backend": "backend.wasm",
  "frontend": "ui.mjs",
  "configuration": "configuration.json",
  "permissions": [
    "clipboard:read",
    "http:request",
    "music:metadata",
    "player:control",
    "ui",
    "config"
  ],
  "engines": {
    "app": "^1.0.0",
    "pluginApi": "^2.0.0",
    "uiApi": "^2.0.0"
  },
  "contributes": {
    "views": [
      {
        "id": "island",
        "slot": "main.overlay",
        "export": "DynamicIsland"
      }
    ],
    "pages": [],
    "navigation": []
  },
  "httpHosts": ["music.163.com", "y.music.163.com", "m.music.163.com", "163cn.tv"]
}
