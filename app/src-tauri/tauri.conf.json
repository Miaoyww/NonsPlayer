{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nons",
  "mainBinaryName": "Nons",
  "version": "1.3.2",
  "identifier": "Nons",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm adapters:build && pnpm plugins:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nons",
        "decorations": false,
        "minWidth": 1200,
        "minHeight": 720,
        "width": 1200,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/**"]
      }
    }
  },
  "bundle": {
    "resources": {
      "bundled-plugins/": "bundled-plugins/",
      "bundled-adapters/": "bundled-adapters/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
