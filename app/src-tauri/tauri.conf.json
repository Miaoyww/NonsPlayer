{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nons",
  "mainBinaryName": "Nons",
  "version": "1.8.0",
  "identifier": "Nons",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm adapters:build && pnpm plugins:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nons",
        "decorations": false,
        "minWidth": 1200,
        "minHeight": 720,
        "width": 1200,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/**"]
      }
    }
  },
  "bundle": {
    "resources": {
      "bundled-plugins/": "bundled-plugins/",
      "bundled-adapters/": "bundled-adapters/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://download.miaoyww.top/nons/releases/latest.json",
        "https://github.com/Miaoyww/Nons/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxM0Q2OUI5NDEwNjI1NzUKUldSMUpRWkJ1V2s5OFpDWlhPOEYxamJ2RWJTRDJPMWxrS010LzVIYmxnZ2lFenQ5RmJxdDdKTE0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
